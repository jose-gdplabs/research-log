# Copy to .env and fill in the empty values
# Bucket created on startup; must match LOKI_S3_BUCKET in loki/.env
S3_BUCKET=loki

# S3 credentials Loki uses; MUST be identical to LOKI_S3_ACCESS_KEY_ID / LOKI_S3_SECRET_ACCESS_KEY in loki/.env
# Generate: openssl rand -hex 16  /  openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
