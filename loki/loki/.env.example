# Copy to .env and fill in the empty values
# Loki storage config: loki-seaweedfs.yaml | loki-filesystem.yaml | loki-s3.yaml
LOKI_CONFIG=loki-seaweedfs.yaml

# Bucket for loki-seaweedfs.yaml / loki-s3.yaml
LOKI_S3_BUCKET=loki

# loki-seaweedfs.yaml only: MUST be identical to S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY in seaweedfs/.env
LOKI_S3_ACCESS_KEY_ID=
LOKI_S3_SECRET_ACCESS_KEY=

# loki-s3.yaml (AWS) only; credentials come from the VM's IAM role, not from here
LOKI_S3_REGION=ap-southeast-3
