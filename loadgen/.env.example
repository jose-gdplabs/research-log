# Copy to .env and edit. The app always sends to the OTel Collector; which backend the logs
# end up in (Loki / OpenSearch / Sentry) is decided by the Collector's config, not here.

PORT=3000
LOADGEN_BIND=127.0.0.1

# --- where to send (OpenTelemetry standard env vars) ---
OTEL_SERVICE_NAME=loadgen
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=bench
# Collector OTLP/HTTP endpoint. host.docker.internal = the VM/host running the collector container.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# Must match OTLP_TOKEN in loki/otel/.env
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer CHANGE_ME

# --- SDK batching (defaults queue only 2048 logs and silently drops the rest at high rates) ---
OTEL_BLRP_MAX_QUEUE_SIZE=65536
OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=4096
OTEL_BLRP_SCHEDULE_DELAY=1000

# --- generator ---
# > 0 starts generating at boot. 0 = idle, drive it via POST /generator/start
LOG_RATE_PER_SEC=0
LOG_LEVEL_MIX=debug:10,info:70,warn:15,error:5
# extra text per log, to control average log size
LOG_PAD_BYTES=0
# also print each log as JSON on stdout (costly at high rates)
LOG_TO_CONSOLE=false
