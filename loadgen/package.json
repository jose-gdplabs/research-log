{
  "name": "loadgen",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS log generator: emits logs through the OpenTelemetry SDK (OTLP) to a collector",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:local": "node --env-file=.env dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  }
}
